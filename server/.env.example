PORT=5000
APP_ORIGIN=http://localhost:5173
# NODE_ENV=production requires HTTPS for session cookies.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=fairsplit
MONGODB_DB=fairsplit
# For Atlas, replace MONGODB_URI with your mongodb+srv:// connection string.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=FairSplit <hello@example.com>
